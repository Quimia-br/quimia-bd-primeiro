root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Duas ou mais quebras de linha no fim têm significado em Markdown.
trim_trailing_whitespace = false

# Os scripts SQL ficam exatamente como foram entregues (ver .pre-commit-config.yaml).
[database/sql/*.sql]
insert_final_newline = false
trim_trailing_whitespace = false
