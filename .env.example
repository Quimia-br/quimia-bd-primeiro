# =============================================================================
# Modelo de configuração do seed. TODOS OS VALORES SÃO FICTÍCIOS.
#
# Copie para .env.test (banco de teste) e para .env (banco principal). Os dois
# ficam fora do Git. Preencha com os dados de cada serviço do Aiven:
#   Copy-Item .env.example .env.test
#   Copy-Item .env.example .env
#
# Uma variável definida no ambiente (PowerShell: $env:SEED_DB_NAME = "...")
# tem prioridade sobre o arquivo.
# =============================================================================

# ---------- Conexão (o seed usa o usuário do serviço, por exemplo avnadmin) ----------
# Host e porta: console do Aiven > serviço > Overview > Connection information.
# A porta do Aiven não é a 5432.
SEED_DB_HOST=pg-exemplo-projeto.aivencloud.com
SEED_DB_PORT=12345
SEED_DB_USER=avnadmin
SEED_DB_PASSWORD=troque-esta-senha
SEED_DB_NAME=defaultdb
SEED_DB_SCHEMA=public

# SSL obrigatório. verify-ca confere se o certificado do servidor foi assinado pelo
# CA do projeto no Aiven. verify-full também confere o nome do host, mas falha no
# Windows com o certificado do Aiven (ver README, Decisões).
# Baixe o "CA certificate" do serviço no console do Aiven e salve em certs/.
SEED_DB_SSLMODE=verify-ca
SEED_DB_SSLROOTCERT=certs/ca-test.pem

# Pool pequeno: os planos do Aiven têm limite de conexões.
SEED_DB_POOL_SIZE=2
SEED_DB_MAX_OVERFLOW=1
# Segundos de espera ao conectar (um timeout costuma indicar IP fora da allowlist).
SEED_DB_CONNECT_TIMEOUT=10

# ---------- Carga ----------
# Fuso em que as colunas TIMESTAMP (sem fuso) são gravadas. Deve ser igual ao
# "SHOW timezone" do servidor, que o "seed check" mostra.
SEED_TIMEZONE=UTC
# Senha em texto usada para gerar o senha_hash dos usuários fictícios
# (é a senha para logar no app com eles). Use uma senha DIFERENTE em cada
# arquivo e que você não use em nenhum outro lugar.
SEED_PASSWORD_PLAIN=senha-de-teste-ficticia
